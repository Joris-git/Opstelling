# Kopieer dit bestand naar ".env" en vul de waarden in.
# Het bestand ".env" wordt NOOIT meegestuurd naar git (staat in .gitignore).

# Poort waarop de applicatie draait. 3000 is een prima standaard.
PORT=3000

# Je Anthropic API-sleutel. Nodig om de toekomstbeelden te laten genereren.
# Zonder deze sleutel werkt de app nog gewoon (met een automatisch fallback-toekomstbeeld),
# maar dan zonder de "echte" AI-tekst en -illustratie.
# Sleutel aanmaken op https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Wachtwoord voor de beheerpagina (/regie). Kies iets unieks, geen standaardwoord.
ADMIN_PASSWORD=verander-dit-wachtwoord

# Geheime sleutel waarmee het inlogbewijs voor /regie wordt "ondertekend".
# Mag een willekeurige lange tekst zijn (bijv. 32+ tekens). Verander dit ook.
SESSION_SECRET=verander-deze-geheime-tekst-ook

# Optioneel: pas aan als je een ander model wilt gebruiken. Standaard is dit prima.
ANTHROPIC_MODEL=claude-sonnet-5
